# AI Agent Observatory - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
# Default: SQLite (no setup required)
DATABASE_URL=sqlite:///observatory.db

# Production: PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/observatory

# =============================================================================
# Observatory Settings
# =============================================================================
ENABLE_OBSERVATORY=true

# =============================================================================
# OpenAI Configuration (for LLM Judge and SemanticCache)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Azure OpenAI Configuration (alternative to OpenAI)
# =============================================================================
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-api-key-here
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
