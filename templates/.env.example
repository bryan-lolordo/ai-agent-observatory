# =============================================================================
# Observatory Configuration
# =============================================================================
# Copy this file to your project as .env and customize

# -----------------------------------------------------------------------------
# REQUIRED: Project Settings
# -----------------------------------------------------------------------------

PROJECT_NAME=My Project
MODEL_PROVIDER=azure                    # azure, openai, anthropic
DEFAULT_MODEL=gpt-4o-mini

# Azure OpenAI (if using Azure)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# OpenAI (if using OpenAI directly)
# OPENAI_API_KEY=your-key-here

# Anthropic (if using Anthropic)
# ANTHROPIC_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# PHASE CONFIGURATION
# -----------------------------------------------------------------------------
# baseline  = Track metrics, detect opportunities, NO behavior changes
# optimized = Apply your OPTIMIZATIONS config, compare to baseline

OBSERVATORY_PHASE=baseline
# OBSERVATORY_PHASE=optimized

# -----------------------------------------------------------------------------
# OPTIONAL: Feature Toggles
# -----------------------------------------------------------------------------

OBSERVATORY_ENABLED=true
JUDGE_ENABLED=true
CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
ROUTER_ENABLED=true

# -----------------------------------------------------------------------------
# OPTIONAL: Database & Cache Paths
# -----------------------------------------------------------------------------

# DATABASE_URL=sqlite:///./observatory.db
# PERSISTENT_CACHE_PATH=./cache/app_cache.db

# -----------------------------------------------------------------------------
# OPTIONAL: Performance Tuning
# -----------------------------------------------------------------------------

CACHE_DEFAULT_TTL=3600
CACHE_MAX_ENTRIES=1000
# SEMANTIC_CACHE_THRESHOLD=0.92

# -----------------------------------------------------------------------------
# OPTIONAL: Production Hardening
# -----------------------------------------------------------------------------

# CB_ENABLED=true                       # Circuit breaker
# CB_FAILURE_THRESHOLD=5
# CB_RECOVERY_TIMEOUT=30

# ASYNC_WRITER_ENABLED=false            # Background writes
# ASYNC_WRITER_BATCH_SIZE=10
